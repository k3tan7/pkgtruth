{
  "$defs": {
    "BehaviorIndicator": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "line": {
          "title": "Line",
          "type": "integer"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "relation": {
          "enum": [
            "NEW",
            "PRESENT",
            "SOURCE_ONLY",
            "UNKNOWN"
          ],
          "title": "Relation",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "line",
        "symbol",
        "relation",
        "explanation",
        "evidence_ids"
      ],
      "title": "BehaviorIndicator",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "artifact_files": {
          "title": "Artifact Files",
          "type": "integer"
        },
        "source_files": {
          "title": "Source Files",
          "type": "integer"
        },
        "compared_files": {
          "title": "Compared Files",
          "type": "integer"
        },
        "identical": {
          "title": "Identical",
          "type": "integer"
        },
        "added": {
          "title": "Added",
          "type": "integer"
        },
        "removed": {
          "title": "Removed",
          "type": "integer"
        },
        "modified": {
          "title": "Modified",
          "type": "integer"
        },
        "excluded_source_files": {
          "title": "Excluded Source Files",
          "type": "integer"
        },
        "byte_limit_per_file": {
          "title": "Byte Limit Per File",
          "type": "integer"
        }
      },
      "required": [
        "artifact_files",
        "source_files",
        "compared_files",
        "identical",
        "added",
        "removed",
        "modified",
        "excluded_source_files",
        "byte_limit_per_file"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Difference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Path"
        },
        "status": {
          "enum": [
            "added",
            "removed",
            "modified",
            "identical"
          ],
          "title": "Status",
          "type": "string"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Sha256"
        },
        "source_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Sha256"
        },
        "classification": {
          "enum": [
            "packaging_metadata",
            "packaging_configuration",
            "unexplained",
            "identical"
          ],
          "title": "Classification",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "binary": {
          "default": false,
          "title": "Binary",
          "type": "boolean"
        },
        "diff": {
          "default": "",
          "title": "Diff",
          "type": "string"
        },
        "excerpt_truncated": {
          "default": false,
          "title": "Excerpt Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "source_path",
        "status",
        "artifact_sha256",
        "source_sha256",
        "classification",
        "evidence_id"
      ],
      "title": "Difference",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "source_excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Excerpt"
        },
        "artifact_excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Excerpt"
        }
      },
      "required": [
        "id",
        "path",
        "description"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "severity": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "INFORMATIONAL"
          ],
          "title": "Severity",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "rule",
        "severity",
        "explanation",
        "evidence_ids"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Mapping": {
      "additionalProperties": false,
      "properties": {
        "source_prefix": {
          "title": "Source Prefix",
          "type": "string"
        },
        "artifact_prefix": {
          "default": "",
          "title": "Artifact Prefix",
          "type": "string"
        },
        "method": {
          "const": "explicit_relative_path",
          "default": "explicit_relative_path",
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "source_prefix"
      ],
      "title": "Mapping",
      "type": "object"
    },
    "MetadataChange": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "field": {
          "enum": [
            "dependencies",
            "console_scripts",
            "gui_scripts"
          ],
          "title": "Field",
          "type": "string"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Path"
        },
        "source_values": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Values"
        },
        "artifact_values": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Values",
          "type": "array"
        },
        "relation": {
          "enum": [
            "PRESENT",
            "CHANGED",
            "UNKNOWN"
          ],
          "title": "Relation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "path",
        "field",
        "source_path",
        "source_values",
        "artifact_values",
        "relation",
        "evidence_ids"
      ],
      "title": "MetadataChange",
      "type": "object"
    },
    "PolicyDecision": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "ALLOW",
            "REVIEW",
            "BLOCK"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/PolicyReason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "limitation": {
          "title": "Limitation",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "reasons",
        "config",
        "limitation"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "PolicyReason": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "rule",
        "explanation",
        "finding_ids",
        "evidence_ids"
      ],
      "title": "PolicyReason",
      "type": "object"
    },
    "RecordCheck": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "NOT_CHECKED",
          "enum": [
            "NOT_CHECKED",
            "VALID",
            "INVALID",
            "UNAVAILABLE",
            "UNRESOLVED"
          ],
          "title": "Status",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "checked_files": {
          "default": 0,
          "title": "Checked Files",
          "type": "integer"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/RecordIssue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "title": "RecordCheck",
      "type": "object"
    },
    "RecordIssue": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "title": "RecordIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.2",
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "tool_version": {
      "default": "0.3.0",
      "title": "Tool Version",
      "type": "string"
    },
    "rule_version": {
      "default": "static-security-2",
      "title": "Rule Version",
      "type": "string"
    },
    "scan_id": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Scan Id",
      "type": "string"
    },
    "analysis_status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "REJECTED"
      ],
      "title": "Analysis Status",
      "type": "string"
    },
    "input_artifact": {
      "title": "Input Artifact",
      "type": "string"
    },
    "source_resolution": {
      "default": "LOCAL_USER_MAPPING",
      "enum": [
        "LOCAL_USER_MAPPING",
        "PYPI_TAG_UNVERIFIED",
        "ARTIFACT_ONLY"
      ],
      "title": "Source Resolution",
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "source_tree_sha256": {
      "title": "Source Tree Sha256",
      "type": "string"
    },
    "source_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Commit"
    },
    "package_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Package Name"
    },
    "package_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Package Version"
    },
    "retrieval": {
      "additionalProperties": true,
      "title": "Retrieval",
      "type": "object"
    },
    "mappings": {
      "items": {
        "$ref": "#/$defs/Mapping"
      },
      "title": "Mappings",
      "type": "array"
    },
    "file_differences": {
      "items": {
        "$ref": "#/$defs/Difference"
      },
      "title": "File Differences",
      "type": "array"
    },
    "record_status": {
      "default": "NOT_CHECKED",
      "enum": [
        "NOT_CHECKED",
        "VALID",
        "INVALID",
        "UNAVAILABLE",
        "UNRESOLVED"
      ],
      "title": "Record Status",
      "type": "string"
    },
    "record_check": {
      "$ref": "#/$defs/RecordCheck"
    },
    "behavior_indicators": {
      "items": {
        "$ref": "#/$defs/BehaviorIndicator"
      },
      "title": "Behavior Indicators",
      "type": "array"
    },
    "metadata_changes": {
      "items": {
        "$ref": "#/$defs/MetadataChange"
      },
      "title": "Metadata Changes",
      "type": "array"
    },
    "provenance_status": {
      "default": "NOT_CHECKED",
      "enum": [
        "NOT_CHECKED",
        "VERIFIED",
        "INVALID",
        "UNAVAILABLE",
        "UNRESOLVED"
      ],
      "title": "Provenance Status",
      "type": "string"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "release_fingerprint": {
      "additionalProperties": true,
      "title": "Release Fingerprint",
      "type": "object"
    },
    "impact_truncated": {
      "default": false,
      "title": "Impact Truncated",
      "type": "boolean"
    },
    "impact_relationships": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Impact Relationships",
      "type": "array"
    },
    "dna_baseline": {
      "additionalProperties": true,
      "title": "Dna Baseline",
      "type": "object"
    },
    "historical_anomalies": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Historical Anomalies",
      "type": "array"
    },
    "model_status": {
      "default": "NOT_CONFIGURED",
      "enum": [
        "NOT_CONFIGURED",
        "VALIDATED",
        "REJECTED",
        "UNAVAILABLE"
      ],
      "title": "Model Status",
      "type": "string"
    },
    "model_details": {
      "additionalProperties": true,
      "title": "Model Details",
      "type": "object"
    },
    "ai_assessments": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Ai Assessments",
      "type": "array"
    },
    "policy_decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "scan_id",
    "analysis_status",
    "input_artifact",
    "artifact_sha256",
    "source_tree_sha256",
    "mappings",
    "file_differences",
    "coverage",
    "findings",
    "evidence",
    "limitations"
  ],
  "title": "Report",
  "type": "object"
}
